# Supabase: Project Settings > Database > Connection string > Session pooler (port 5432)
# Replace [YOUR-PASSWORD] and URL-encode special characters in it (e.g. @ becomes %40)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Where the Next.js frontend runs (used for CORS and links in emails)
FRONTEND_URL=http://localhost:3000

# Cookies: keep False on http://localhost, set True in production (https)
COOKIE_SECURE=False

# Brevo transactional email (HTTPS API). Leave empty in development to print emails to the console.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=you@your-verified-domain.com
EMAIL_FROM_NAME=Agri Shift
